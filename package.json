{
  "name": "libecity-desktop",
  "version": "1.0.0",
  "description": "libecity desktop app",
  "scripts": {
    "build": "node build.mjs && chmod o+r dist/*",
    "watch": "tsc -w",
    "lint": "eslint ./src",
    "test": "node scripts/test-daemon.mjs",
    "start": "npm run build && electron-forge start",
    "clean": "rm -rf dist",
    "electron-forge": "electron-forge",
    "package": "npm run clean && npm run build && electron-forge package",
    "make": "npm run clean && npm run build && electron-forge make",
    "make:local": "npm run clean && npm run build && electron-forge make --targets @electron-forge/maker-deb,@electron-forge/maker-zip",
    "make:all": "npm run clean && npm run build && electron-forge make -a x64,arm64 -p darwin && electron-forge make -a x64,arm64 -p linux && electron-forge make -a x64 -p win32"
  },
  "main": "dist/main.js",
  "repository": "TBW",
  "keywords": [
    "Electron",
    "typescript"
  ],
  "author": "GitHub",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "electron": "^42.10.1",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-window-state": "^5.0.3",
    "firebase": "^12.18.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "brace-expansion": "^5.0.2"
  }
}
